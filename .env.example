# Optional shell environment template. The application does not load .env files.
# Set values in your shell or pass PYTHON/UV directly to make.
# Use an activated environment or replace python3 with an installed interpreter.
PYTHON=python3
UV=uv
# Separately prepared environment containing approved quality tools:
QA_PYTHON=.tools/qa/bin/python

# Offline local verification. Make enforces these settings for its check targets.
PYTHONDONTWRITEBYTECODE=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
UV_OFFLINE=1
UV_PYTHON_DOWNLOADS=never
PIP_NO_INDEX=1
PIP_DISABLE_PIP_VERSION_CHECK=1

# No API keys or external-service credentials are needed for current local checks.
# Keep any future approved credentials outside source control; never paste them here.
